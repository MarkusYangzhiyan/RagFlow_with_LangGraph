# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.template

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/

# Coverage reports
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and package artifacts
build/
dist/
downloads/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Logs, temporary files, and runtime files
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*~
*.pid

# Project-generated data and outputs
data/*
!data/.gitkeep
!data/README.md
!data/manifest.csv
!data/manifest.schema.json
output/*
!output/.gitkeep
!output/README.md

# IDE and editor settings
.idea/
.vscode/
*.code-workspace

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
