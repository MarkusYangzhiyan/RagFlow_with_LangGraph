{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BidGuard Manifest Record",
  "description": "Validation rules for one document record in manifest.csv",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "project_id",
    "project_code",
    "project_name",
    "domain",
    "artifact_role",
    "authenticity",
    "publisher",
    "procuring_entity",
    "procurement_agency",
    "source_page_url",
    "download_url",
    "published_date",
    "collected_at",
    "original_filename",
    "local_path",
    "media_type",
    "byte_size",
    "sha256",
    "download_status",
    "access_level",
    "redistribution_status",
    "contains_personal_data",
    "redaction_status",
    "notes"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^DOC-[0-9]{4}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{4}$"
    },
    "project_code": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "software_development",
        "it_operations",
        "network_security",
        "it_infrastructure",
        "it_supervision",
        "other_it"
      ]
    },
    "artifact_role": {
      "type": "string",
      "enum": [
        "tender_notice",
        "tender_document",
        "technical_attachment",
        "correction_notice",
        "award_notice",
        "award_attachment",
        "template",
        "synthetic_response"
      ]
    },
    "authenticity": {
      "type": "string",
      "enum": [
        "real_public",
        "synthetic_controlled"
      ]
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "procuring_entity": {
      "type": "string",
      "minLength": 1
    },
    "procurement_agency": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_page_url": {
      "type": "string",
      "format": "uri"
    },
    "download_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "published_date": {
      "type": "string",
      "format": "date"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "original_filename": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "local_path": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^data/raw/PRJ-[0-9]{4}/.+$"
    },
    "media_type": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "byte_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "download_status": {
      "type": "string",
      "enum": [
        "not_attempted",
        "downloaded",
        "failed",
        "requires_login",
        "not_applicable"
      ]
    },
    "access_level": {
      "type": "string",
      "enum": [
        "public_no_login",
        "public_registration",
        "restricted",
        "unknown"
      ]
    },
    "redistribution_status": {
      "type": "string",
      "enum": [
        "permitted",
        "metadata_only",
        "prohibited",
        "unknown"
      ]
    },
    "contains_personal_data": {
      "type": "boolean"
    },
    "redaction_status": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "not_required",
        "redacted"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "download_status": {
            "const": "downloaded"
          }
        },
        "required": [
          "download_status"
        ]
      },
      "then": {
        "properties": {
          "original_filename": {
            "type": "string",
            "minLength": 1
          },
          "local_path": {
            "type": "string",
            "pattern": "^data/raw/PRJ-[0-9]{4}/.+$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "byte_size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authenticity": {
            "const": "synthetic_controlled"
          }
        },
        "required": [
          "authenticity"
        ]
      },
      "then": {
        "properties": {
          "artifact_role": {
            "const": "synthetic_response"
          }
        }
      }
    }
  ]
}
